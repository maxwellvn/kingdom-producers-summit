APP_NAME="The Loveworld Kingdom Producers Summit"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://summit.example.com

DB_HOST=db
DB_PORT=3306
DB_CREATE_DATABASE=false
DB_NAME=lw_producers_summit
DB_USER=producers
DB_PASS=replace-with-a-strong-password
DB_ROOT_PASS=replace-with-a-different-strong-password

# Generate with: php -r "echo bin2hex(random_bytes(32));"
APP_KEY=

# Admin login. Generate hash with: php -r "echo password_hash('your-password', PASSWORD_DEFAULT);"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=

MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_ENCRYPTION=ssl
MAIL_USERNAME=mailbox@example.com
MAIL_PASSWORD=replace-with-mailbox-password
MAIL_FROM=mailbox@example.com
MAIL_FROM_NAME="Loveworld Kingdom Producers Summit"
MAIL_REPLY_TO=unitedkingdom@loveworldconsulate.org

# Sessions are stored in storage/sessions so another application's cleanup
# cannot expire them early. The web user must be able to create that folder.

# KingsChat notifications. An organiser connects the sending account once from
# Admin > KingsChat; the tokens are stored in the database, never a password.
KINGSCHAT_ENABLED=true
KINGSCHAT_CLIENT_ID=com.kingschat
KINGSCHAT_SENDER=lwconsul_uk

# Stripe (card payments). Use test keys locally. The webhook secret is shown
# when you add the endpoint <APP_URL>/webhooks/stripe in the Stripe dashboard.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Large media (videos) are not in git. Pinned copy served by jsDelivr from the last commit that held them.
MEDIA_URL=https://cdn.jsdelivr.net/gh/maxwellvn/kingdom-producers-summit@35c9dd5/public/assets/media
