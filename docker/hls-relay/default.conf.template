# HLS relay: pulls the stream once from the hidden origin, caches it, serves every viewer.
# URLs are signed by the summit app (see StreamService::relayUrl) and expire.
proxy_cache_path /var/cache/nginx/hls levels=1:2 keys_zone=hls:20m max_size=2g inactive=10m use_temp_path=off;

server {
    listen 80;
    resolver 1.1.1.1 8.8.8.8 valid=300s ipv6=off;  # no IPv6 route in the container

    location = /healthz { return 200 "ok\n"; }

    # /hls/<expires>/<token>/<file>  token = base64url(md5(SECRET . expires))
    location ~ ^/hls/(?<exp>\d+)/(?<tok>[^/]+)/(?<file>.+)$ {
        secure_link $tok,$exp;
        secure_link_md5 "${SECRET}$exp";
        if ($secure_link = "")  { return 403; }
        if ($secure_link = "0") { return 410; }

        # ponytail: relative playlist references only. An origin whose master playlist uses
        # absolute URLs would leak itself; rewrite with sub_filter if that ever happens.
        proxy_pass ${ORIGIN}/$file;
        proxy_ssl_server_name on;
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        proxy_set_header Connection "";
        proxy_set_header Range "";        # always fetch whole files so every response is a cacheable 200
        proxy_hide_header Set-Cookie;

        proxy_cache hls;
        proxy_cache_key $file;
        # ponytail: one TTL for playlists and segments. With the lock plus stale-while-updating,
        # the origin sees at most one fetch per file per second whatever the viewer count.
        proxy_cache_valid 200 206 1s;
        proxy_cache_lock on;
        proxy_cache_use_stale updating error timeout;
        proxy_ignore_headers Cache-Control Expires Set-Cookie;

        add_header Cache-Control "no-store";
        add_header Access-Control-Allow-Origin "*";
        add_header X-Cache $upstream_cache_status;
    }

    location / { return 404; }
}
